# Validation fixture: zuse check examples/validate-api.zuse
# The placeholder window and example node path make this unsuitable for execution.
import(path="../lib.zuse", as="std")
std.desktop.inspect()
std.timing.start()
std.desktop.focus(window_id="OBSERVED_WINDOW_ID")
std.desktop.bind_canvas(name="board", window_id="OBSERVED_WINDOW_ID", x=160, y=180, width=640, height=480)
std.desktop.click(canvas="board", x=20, y=20)
std.drawing.stroke(canvas="board", points="40,120;160,40;280,120", duration=240)
std.drawing.line(canvas="board", x1=40, y1=160, x2=280, y2=160)
std.drawing.triangle(canvas="board", x1=360, y1=280, x2=480, y2=280, x3=420, y3=200)
std.drawing.rectangle(canvas="board", x=40, y=200, width=120, height=80)
std.drawing.circle(canvas="board", x=230, y=240, radius=40)
std.drawing.polygon(canvas="board", points="330,200;390,280;270,280", duration=240)
std.drawing.arrow(canvas="board", x1=40, y1=340, x2=240, y2=340, head="220,320;240,340;220,360")
std.fractal.sierpinski(canvas="board", x=40, y=430, width=200, height=150, depth=2)
std.timing.pause(ms=50)
std.timing.status()
std.timing.stop()
std.timing.reset()
std.desktop.capture(window_id="OBSERVED_WINDOW_ID", path="canvas.png")
std.desktop.release_canvas(name="board")
std.input.type_in(window_id="OBSERVED_WINDOW_ID", text="Example text")
std.input.key_in(window_id="OBSERVED_WINDOW_ID", key="Tab")
std.input.set_text(node_path="0/1", text="Example text")
